{
  "include": [
    "./src-typescript/**/*.ts"
  ],
  "exclude": [
    "./test/"
  ],
  "compilerOptions": {
    "target": "es2017",
    "module": "ES2015",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "www",
    "types": [
      "cordova",
      "node"
    ]
  }
}